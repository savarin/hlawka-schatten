module

public import HlawkaSchatten.BelowExponent.Vertex.SideOuterWideCheck
public import HlawkaSchatten.BelowExponent.Vertex.SideOuterTreeSearch
public import HlawkaSchatten.BelowExponent.Vertex.SideCornerData.RowTables
public import HlawkaSchatten.BelowExponent.Vertex.CornerPointData

/-! Emit literal closed row trees and their independently checked point bounds. -/

public section

namespace HlawkaSchatten.BelowExponent.Vertex

private def pad (n : Nat) : String :=
  if n < 10 then s!"00{n}" else if n < 100 then s!"0{n}" else toString n

private def scSkip (k : Fin 3) (i j : Fin 34) : Bool :=
  ((scOuterSkipCache.get k).get i).testBit j.val

private def intervalLiteral (r : DyadicBounds) : String :=
  s!"⟨{r.lo}, {r.hi}, {r.ok}⟩"

private def vectorLiteral (xs : List String) : String :=
  "#v[" ++ String.intercalate ", " xs ++ "]"

private def argumentLiteral (x : ℚ) : String :=
  s!"{x.num}/{x.den}"

private def serializePoint (p : OuterPointBounds) : String :=
  let d := vectorLiteral (p.diagonal.toList.map intervalLiteral)
  let c := vectorLiteral (p.coupling.toList.map fun row => vectorLiteral (row.toList.map intervalLiteral))
  let a := vectorLiteral (p.argument.toList.map argumentLiteral)
  s!"⟨{d}, {c}, {a}⟩"

def prepareSCOuterBounds (family stem : String) (points : Array SideCornerEntry)
    (roots : Array (Fin 3 → RatBounds)) (args : List String) : IO Unit := do
  let [dir] := args | throw (IO.userError "Usage: sc-outer-prepare.lean OUTPUT_DIRECTORY")
  unless points.size == 880 && roots.size == 880 do
    throw (IO.userError "Expected 880 points and matching fifth-root brackets")
  let path := System.FilePath.mk dir
  IO.FS.createDirAll path
  for chunk in [0:28] do
    let start := 32*chunk
    let stop := min (start+32) points.size
    let mut source := "module\n\npublic import HlawkaSchatten.BelowExponent.Vertex.OuterRowCheck\n"
    source := source ++ s!"public import HlawkaSchatten.BelowExponent.Vertex.{family}.Points{pad start}\n"
    source := source ++ "\n@[expose] public section\n\nnamespace HlawkaSchatten.BelowExponent.Vertex\n\n"
    source := source ++ "-- Generated by scripts/certificates/facet-vertex/compiled-preparation/sc-outer-prepare.lean.\n\n"
    for i in [start:stop] do
      let some p := points[i]? | throw (IO.userError s!"Missing point {i}")
      let some r := roots[i]? | throw (IO.userError s!"Missing radicals at point {i}")
      let b := OuterPointBounds.atPoint p.a p.b p.eta p.margin r
      let name := s!"{stem}P{pad i}"
      source := source ++ s!"def {name}Bounds : OuterPointBounds := {serializePoint b}\n"
      source := source ++ s!"theorem {name}_bounds_eq :\n"
      source := source ++ s!"    {name}Bounds = .atPoint {name}.a {name}.b {name}.eta {name}.margin {name}Roots :=\n"
      source := source ++ "  by decide +kernel\n\n"
    IO.FS.writeFile (path / s!"Bounds{pad start}.lean") (source ++ "end HlawkaSchatten.BelowExponent.Vertex\n")
  IO.println "880 fixed-point parameter bounds in 28 shards"

private def witnessModule (family stem : String) (index : Nat) (trees : List SideOuterTree) : String := Id.run do
  let name := s!"{stem}P{pad index}"
  let start := index / 32 * 32
  let mut source := "module\n\npublic import HlawkaSchatten.BelowExponent.Vertex.SideOuterWideCheck\n"
  source := source ++ "public import HlawkaSchatten.BelowExponent.Vertex.SideOuterTreeSearch\n"
  source := source ++ "public import HlawkaSchatten.BelowExponent.Vertex.SideOuterCheck\n"
  source := source ++ s!"public import HlawkaSchatten.BelowExponent.Vertex.{family}.Bounds{pad start}\n"
  source := source ++ "\n@[expose] public section\n\nnamespace HlawkaSchatten.BelowExponent.Vertex\n\n"
  source := source ++ "-- Generated by scripts/certificates/facet-vertex/compiled-preparation/sc-outer-wide-prepare.lean.\n\n"
  source := source ++ "set_option maxRecDepth 30000\nset_option maxHeartbeats 0\n\n"
  source := source ++ s!"def {name}WideTrees : Vector SideOuterTree 12 := #v[\n  "
  source := source ++ String.intercalate ",\n  " (trees.map SideOuterTree.dataSource) ++ "]\n\n"
  source := source ++ s!"def {name}WideTree (k : Fin 3) (s t : Bool) : SideOuterTree :=\n"
  source := source ++ s!"  {name}WideTrees.get (outerTreeIndex k s t)\n\n"
  source := source ++ s!"theorem {name}_wide_checks : ∀ (k : Fin 3) (s t : Bool),\n"
  source := source ++ s!"    ({name}WideTree k s t).check (outerWideRectOK {name}Bounds) scOuterSkips k\n"
  source := source ++ "      (sideOuterStart s) (sideOuterStart t) = true := by decide +kernel\n\n"
  return source ++ "end HlawkaSchatten.BelowExponent.Vertex\n"

private def emit (family stem : String) (points : Array SideCornerEntry)
    (rootTable : Array (Fin 3 → RatBounds)) (dst : System.FilePath) (index : Nat) : IO Unit := do
  let some p := points[index]? | throw (IO.userError s!"Missing SC point {index}")
  let some roots := rootTable[index]? | throw (IO.userError s!"Missing SC radicals at {index}")
  let point := OuterPointBounds.atPoint p.a p.b p.eta p.margin roots
  let some trees := outerSearchQuadrants (outerWideRectOK point) scSkip |
    throw (IO.userError s!"Point {index} has an open fine rectangle")
  unless trees.length == 12 do
    throw (IO.userError s!"Expected twelve closed quadrant trees for point {index}")
  let count := trees.foldl (fun sum t => sum + t.rectangleCount) 0
  let file := dst / s!"Wide{pad index}.lean"
  let source := witnessModule family stem index trees
  if ← file.pathExists then
    if (← IO.FS.readFile file) != source then
      IO.FS.writeFile file source
  else
    IO.FS.writeFile file source
  IO.println s!"{index} {count} checked-candidate rectangles"

def prepareSCOuterWide (family stem : String) (points : Array SideCornerEntry)
    (rootTable : Array (Fin 3 → RatBounds)) (args : List String) : IO Unit := do
  let dir :: indices := args | throw (IO.userError "Usage: sc-outer-wide-prepare.lean OUTPUT_DIR [INDEX ...]")
  let dst := System.FilePath.mk dir
  IO.FS.createDirAll dst
  if indices.isEmpty then
    for index in [:points.size] do emit family stem points rootTable dst index
  else
    for text in indices do
      let some index := text.toNat? | throw (IO.userError s!"Invalid corner index {text}")
      emit family stem points rootTable dst index

end HlawkaSchatten.BelowExponent.Vertex
