import HlawkaSchatten.BelowExponent.Vertex.OuterRowCheck
import HlawkaSchatten.BelowExponent.Vertex.CornerPowerTables

open HlawkaSchatten.BelowExponent.Vertex

private def intervalLiteral (r : DyadicBounds) : String :=
  s!"⟨{r.lo}, {r.hi}, {r.ok}⟩"

private def axisLiteral (r : OuterAxisBounds) : String :=
  "⟨" ++ String.intercalate ", " ([r.absChord, r.absTangent, r.signedChord, r.signedTangent].map intervalLiteral) ++ "⟩"

private def vectorLiteral (xs : List String) : String :=
  "#v[" ++ String.intercalate ", " xs ++ "]"

private def canonicalAxis (i : Fin 34) (e : Bool) : OuterAxisBounds :=
  outerAxisBounds i e (outerEndpointAbsQ i e) (outerEndpointSigned i e)
    (outerMidAbsQ i) (outerMidSigned i) (outerMidSlope i)

private def skipMask (k : Fin 3) (i : Fin 34) : Nat :=
  (List.finRange 34).foldl (fun acc j => if outerSideSkip k i j then acc + (1 <<< j.val) else acc) 0

def main (args : List String) : IO Unit := do
  let [output] := args | throw (IO.userError "Usage: sc-outer-row-tables.lean OUTPUT_FILE")
  let axes := (List.finRange 34).map fun i =>
    "  " ++ vectorLiteral ([false,true].map fun e => axisLiteral (canonicalAxis i e))
  let masks := (List.finRange 3).map fun k =>
    "  " ++ vectorLiteral ((List.finRange 34).map fun i => toString (skipMask k i))
  let header := "module\n\npublic import HlawkaSchatten.BelowExponent.Vertex.OuterRowCheck\n\n@[expose] public section\n\n"
  let header := header ++ "namespace HlawkaSchatten.BelowExponent.Vertex\n\n-- Generated by scripts/certificates/facet-vertex/compiled-preparation/sc-outer-row-tables.lean.\n\n"
  let data := "def scOuterAxisCache : Vector (Vector OuterAxisBounds 2) 34 := #v[\n" ++
    String.intercalate ",\n" axes ++ "]\n\n" ++
    "def scOuterSkipCache : Vector (Vector Nat 34) 3 := #v[\n" ++
    String.intercalate ",\n" masks ++ "]\n\nend HlawkaSchatten.BelowExponent.Vertex\n"
  IO.FS.writeFile output (header ++ data)
