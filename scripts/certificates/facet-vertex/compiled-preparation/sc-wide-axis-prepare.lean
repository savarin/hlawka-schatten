import HlawkaSchatten.BelowExponent.Vertex.CornerSpanAxes

open HlawkaSchatten.BelowExponent.Vertex

private partial def spans (s : SideOuterSpan) : List SideOuterSpan :=
  if s.lo.val+1 < s.hi.val then s :: (spans s.first ++ spans s.second) else [s]

private def intervalLiteral (r : DyadicBounds) : String :=
  s!"⟨{r.lo}, {r.hi}, {r.ok}⟩"

private def axisLiteral (r : OuterAxisBounds) : String :=
  "⟨" ++ String.intercalate ", " ([r.absChord, r.absTangent, r.signedChord, r.signedTangent].map intervalLiteral) ++ "⟩"

def main (args : List String) : IO Unit := do
  let [output] := args | throw (IO.userError "Usage: sc-wide-axis-prepare.lean OUTPUT_FILE")
  let all := spans (sideOuterStart false) ++ spans (sideOuterStart true)
  unless all.length == 66 do
    throw (IO.userError "Expected 66 distinct midpoint spans")
  let rows := (List.finRange 35).map fun lo =>
    let select := all.filter (fun s => s.lo == lo)
    let vals := select.map fun s =>
      let first := axisLiteral (outerWideSpanAxesCanonical s false)
      let last := axisLiteral (outerWideSpanAxesCanonical s true)
      s!"({s.hi.val}, #v[{first}, {last}])"
    "  [" ++ String.intercalate ", " vals ++ "]"
  let header := "module\n\npublic import HlawkaSchatten.BelowExponent.Vertex.OuterRowCheck\n\n@[expose] public section\n\n"
  let header := header ++ "namespace HlawkaSchatten.BelowExponent.Vertex\n\n-- Generated by scripts/certificates/facet-vertex/compiled-preparation/sc-wide-axis-prepare.lean.\n\n"
  let body := "def outerWideAxisBank : Vector (List (Fin 35 × Vector OuterAxisBounds 2)) 35 := #v[\n" ++
    String.intercalate ",\n" rows ++ "]\n\nend HlawkaSchatten.BelowExponent.Vertex\n"
  IO.FS.writeFile output (header ++ body)
  IO.println "66 spans and 132 cached endpoint records"
