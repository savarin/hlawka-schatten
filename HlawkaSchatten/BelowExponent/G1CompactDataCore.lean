def compactWitness (i : Fin 13) (right : Bool) (j : Fin 64) : ℕ × ℕ × ℕ :=
  let block := compactWitnesses[i.val*2 + (if right then 1 else 0)]?.getD #[]
  block[j.val]?.getD (0,0,0)

def lengthNum (i : Fin 13) (right : Bool) : ℕ :=
  g1LengthNumerator (if right then i.succ else i.castSucc)

def lengthRat (i : Fin 13) (right : Bool) : ℚ := (lengthNum i right : ℚ)/4096
def weightRat (i : Fin 13) : ℚ := (g1WeightNumerator i : ℚ)/1000
def eNode (j : Fin 65) : ℚ := (j.val : ℚ)/128

def knotNum (j : Fin 129) : ℤ := (j.val : ℤ)-64
def knot (j : Fin 129) : ℚ := (knotNum j : ℚ)/256
def ordinate (j : Fin 129) : ℚ :=
  (lowerOrdinates[(knotNum j).natAbs]?.getD 0 : ℚ) / tangentScale

def midpointNum (j : Fin 128) : ℕ :=
  (knotNum j.castSucc).natAbs + (knotNum j.succ).natAbs
def midpoint (j : Fin 128) : ℚ := (midpointNum j : ℚ)/512
def midBounds (j : Fin 128) : ℕ × ℕ :=
  midpointBounds[(if j.val < 64 then 63-j.val else j.val-64)]?.getD (0,0)
def centerNode (j : Fin 128) (right : Bool) : Fin 129 :=
  if right then j.succ else j.castSucc

def tangentOffset (j : Fin 128) (right : Bool) : ℚ :=
  |knot (centerNode j right)| / midpoint j - 1

def tangentFactor (j : Fin 128) (right : Bool) : ℚ :=
  let d := tangentOffset j right
  1 + (if 0 ≤ d then qLo else qHi)*d

def tangentPower (j : Fin 128) (right : Bool) : ℕ :=
  if 0 ≤ tangentFactor j right then (midBounds j).1 else (midBounds j).2

def tangentTest (j : Fin 128) (right : Bool) : Prop :=
  ordinate (centerNode j right) ≤ (tangentPower j right : ℚ)/powerScale * tangentFactor j right

instance (j : Fin 128) (right : Bool) : Decidable (tangentTest j right) := by
  unfold tangentTest
  infer_instance

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem midpointChecks :
    ∀ j : Fin 128, (0 < midpointNum j ∧ midpointNum j ≤ 512) ∧
      ((0 ≤ knot j.castSucc ∧ 0 ≤ knot j.succ) ∨ (knot j.castSucc ≤ 0 ∧ knot j.succ ≤ 0)) ∧
      (midBounds j).1^41 * 512^65 ≤ (midpointNum j)^65 * powerScale^41 ∧
      (midpointNum j)^84 * powerScale^53 ≤ (midBounds j).2^53 * 512^84 := by
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem tangentChecks : ∀ j : Fin 128, tangentTest j false ∧ tangentTest j true := by
  decide +kernel

def compactParams (i : Fin 13) (right : Bool) (j : Fin 64) : G1CompactParams :=
  let witness := compactWitness i right j
  let l := lengthRat i right
  let μ := weightRat i
  let E := eNode j.succ
  let V := 1 - (eNode j.castSucc)^2
  let R := E+9*l
  let T := cHi + (1/2-cHi)*R^2
  let a := (1-μ+μ*l)*cLo - (1-μ)*T*E^2
  let C := (1-(1/(witness.1:ℚ)))*a
  let k := (1-μ)*T+((1-μ)*T*E)^2/(a-C)
  let w := (witness.2.1 : ℚ)/wScale
  let powerUpper := (witness.2.2 : ℚ)/powerScale
  let α := (qHi/2)*powerUpper/w^2
  let β := (1-qLo/2)*powerUpper
  ⟨l, μ, E, V, T, a, C, k, w, powerUpper, α, β⟩

def compactCost (P : G1CompactParams) (z : ℚ) : ℚ :=
  P.k*P.l^2/P.μ*(z-1)^2 + P.β + P.α*((1-P.l)*z+P.l)^2

def overlapsCompact (l w : ℕ) (j : Fin 128) : Prop :=
  -64*(w:ℤ) ≤ (4096-(l:ℤ))*knotNum j.succ + 256*(l:ℤ) ∧
    (4096-(l:ℤ))*knotNum j.castSucc + 256*(l:ℤ) ≤ 64*(w:ℤ)

instance (l w : ℕ) (j : Fin 128) : Decidable (overlapsCompact l w j) := by
  unfold overlapsCompact
  infer_instance

def compactBasicOK (i : Fin 13) (right : Bool) (j : Fin 64) : Prop :=
  let witness := compactWitness i right j
  let P := compactParams i right j
  0 < P.l ∧ P.l < 1 ∧ 0 < P.μ ∧ P.μ < 1 ∧ 0 < P.w ∧ P.w ≤ 1 ∧
  P.E+9*P.l ≤ 1 ∧ 0 < P.a-P.C ∧ 0 ≤ P.k ∧
  witness.2.1^84 * powerScale^53 ≤ witness.2.2^53 * wScale^84 ∧
  P.μ*P.α*P.V ≤ P.C ∧ P.k*P.l/P.μ ≤ cLo*(1-P.l)*(27/64) ∧
  P.w+P.l ≤ (1-P.l)/4

instance (i : Fin 13) (right : Bool) (j : Fin 64) :
    Decidable (compactBasicOK i right j) := by
  unfold compactBasicOK
  infer_instance

def compactCornersOK (i : Fin 13) (right : Bool) (j : Fin 64) : Prop :=
  let P := compactParams i right j
  ∀ z : Fin 128, overlapsCompact (lengthNum i right) (compactWitness i right j).2.1 z →
    ∀ edge : Bool,
      compactCost P (knot (centerNode z edge)) ≤ P.l+(1-P.l)*ordinate (centerNode z edge)

instance (i : Fin 13) (right : Bool) (j : Fin 64) :
    Decidable (compactCornersOK i right j) := by
  unfold compactCornersOK
  infer_instance

