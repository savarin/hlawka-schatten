module

public import HlawkaSchatten.BelowExponent.G1Far

/-! Exact rational certificates for the compact G1 chart. Each slab endpoint
has one witness per e interval. The central chart uses signed knots spaced
1/256 apart and lower tangents at the midpoints. -/

set_option autoImplicit true
set_option relaxedAutoImplicit true
set_option linter.mathlibStandardSet false

@[expose] public section

namespace HlawkaSchatten.BelowExponent

structure G1CompactParams where
  l : ℚ
  μ : ℚ
  E : ℚ
  V : ℚ
  T : ℚ
  a : ℚ
  C : ℚ
  k : ℚ
  w : ℚ
  powerUpper : ℚ
  α : ℚ
  β : ℚ

namespace G1CompactData

open Set

set_option maxRecDepth 16000

def qLo : ℚ := 84/53
def qHi : ℚ := 65/41
def cLo : ℚ := qLo*(qLo-1)/2
def cHi : ℚ := qHi*(qHi-1)/2
def tangentScale : ℕ := 2^36
def powerScale : ℕ := 2^40
def wScale : ℕ := 16384

