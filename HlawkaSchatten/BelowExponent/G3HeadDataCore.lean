def headPower (n : ℕ) : ℕ × ℕ :=
  ((headPowerBlocks[n/64]?.getD #[])[n%64]?).getD (0,0)

def headPowerOK (n : ℕ) : Prop :=
  let (lo, hi) := headPower n
  if n ≤ 1024 then
    lo^41*1024^65 ≤ n^65*headScale^41 ∧ n^84*headScale^53 ≤ hi^53*1024^84
  else
    lo^53*1024^84 ≤ n^84*headScale^53 ∧ n^65*headScale^41 ≤ hi^41*1024^65

instance (n : ℕ) : Decidable (headPowerOK n) := by
  unfold headPowerOK
  infer_instance

set_option maxHeartbeats 0 in
theorem headPowerChecks : ∀ i : Fin 2049, headPowerOK i.val := by decide +kernel

def headLower (n : ℕ) : ℚ := ((headPower n).1 : ℚ)/headScale
def headUpper (n : ℕ) : ℚ := ((headPower n).2 : ℚ)/headScale

def headRatioRow (i : Fin 50) : ℕ × ℕ × ℕ :=
  headRatioRows[i.val]?.getD (0,0,0)

def headRatioLeft (i : Fin 50) : ℚ := ((headRatioRow i).1 : ℚ)/headScale
def headRatioRise (i : Fin 50) : ℚ := ((headRatioRow i).2.1 : ℚ)/headScale
def headRatioInv (i : Fin 50) : ℚ := ((headRatioRow i).2.2 : ℚ)/headScale

def headRatioOK (i : Fin 50) : Prop :=
  let (a,b,c) := headRatioRow i
  a^25*250^12 ≤ i.val^12*headScale^25 ∧
  (i.val+1)^139*headScale^1325 ≤ b^1325*250^139 ∧
  250^31*headScale^53 ≤ c^53*(499-i.val)^31 ∧
  (250/147-headRatioLeft i)*headRatioRise i*headRatioInv i ≤ 3/4

instance (i : Fin 50) : Decidable (headRatioOK i) := by
  unfold headRatioOK
  infer_instance

set_option maxHeartbeats 0 in
theorem headRatioChecks : ∀ i, headRatioOK i := by decide +kernel

def headDepthNum : Fin 5 → ℕ := ![0,8,14,16,17]
def headDepth (i : Fin 5) : ℚ := (headDepthNum i : ℚ)/32
def headKHi (upper : Bool) : ℚ := if upper then 1/9 else 3/37
def headKPowerLo (upper : Bool) : ℚ := if upper then 2/9 else 0
/-- The left and right endpoints of the 12 intervals in the compact head chart. -/
def headPN (j : Fin 13) : ℤ := ![-64,-19,-7,-1,2,4,6,8,11,15,23,45,64] j
def headP (j : Fin 13) : ℚ := (headPN j : ℚ)/512
def headPAbsNum (j : Fin 12) : ℕ :=
  (max 0 (max (headPN j.castSucc) (-headPN j.succ))).toNat
def headPAbs (j : Fin 12) : ℚ := (headPAbsNum j : ℚ)/512
def headWNum (j : Fin 12) : ℕ := (512-headPN j.castSucc).toNat
def headW (j : Fin 12) : ℚ := (headWNum j : ℚ)/512
def headCenterNum (upper : Bool) (j : Fin 12) : ℕ :=
  min 64 (if upper then 64*9*headPAbsNum j/headWNum j else
    64*37*headPAbsNum j/(3*headWNum j))
def headCenter (upper : Bool) (j : Fin 12) : ℚ := (headCenterNum upper j : ℚ)/64
def headAngularNum (i : Fin 49) : ℤ := (i.val : ℤ)-16
def headAngular (i : Fin 49) : ℚ := (headAngularNum i : ℚ)/32

def headJLow (i : Fin 4) (upper : Bool) (j : Fin 12) : ℚ :=
  headLower (2*headPAbsNum j) - 1 + headQL*(1-headP j.succ) -
    (1/2)*headDepth i.succ*headKHi upper*(headW j)^2

def headR (i : Fin 4) (upper : Bool) (j : Fin 12) : ℚ :=
  (3/4-(headDepth i.castSucc/16)*headKPowerLo upper)/(1+headDepth i.castSucc/16) *
    headUpper (2*headWNum j)

def headT (upper : Bool) (j : Fin 12) : ℚ := (9/8)*headKHi upper*(headW j)^2

def headDLower (P : ℕ) (y : ℤ) : ℚ :=
  (headLower ((16*(P:ℤ)+y).natAbs)+headLower ((16*(P:ℤ)-y).natAbs))/2

def headDUpper (P : ℕ) (y : ℤ) : ℚ :=
  (headUpper ((16*(P:ℤ)+y).natAbs)+headUpper ((16*(P:ℤ)-y).natAbs))/2

def headYN (i : Fin 4) (a : Fin 49) : ℤ :=
  (32-(headDepthNum i.succ:ℤ))*headAngularNum a+32*(headDepthNum i.succ:ℤ)

def headPairOK (i : Fin 4) (upper : Bool) (j : Fin 12) : Prop :=
  let P := headCenterNum upper j
  0 < headDepth i.succ ∧ 0 ≤ headR i upper j ∧ 0 ≤ headT upper j ∧
  headCenter upper j*headKHi upper*headW j ≤ headPAbs j ∧
  2*headPAbsNum j ≤ 2048 ∧ 2*headWNum j ≤ 2048 ∧
  ∀ a : Fin 49,
    (16*(P:ℤ)+32*headAngularNum a).natAbs ≤ 2048 ∧
    (16*(P:ℤ)-32*headAngularNum a).natAbs ≤ 2048 ∧
    (16*(P:ℤ)+headYN i a).natAbs ≤ 2048 ∧
    (16*(P:ℤ)-headYN i a).natAbs ≤ 2048 ∧
    headR i upper j*max 0
      ((headDUpper P (headYN i a)-headDLower P (32*headAngularNum a))/headDepth i.succ) +
      headT upper j*(headAngular a)^2 + headR i upper j/(729*headDepth i.succ) ≤ headJLow i upper j

instance (i : Fin 4) (upper : Bool) (j : Fin 12) : Decidable (headPairOK i upper j) := by
  unfold headPairOK
  infer_instance

